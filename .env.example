# Backend settings. Run uvicorn from the repository root so this .env file is found.
# Leave the audit database path empty to keep audits in memory.
SEARCHLENS_AUDIT_DB_PATH=

# Crawl limits and network behaviour.
SEARCHLENS_REQUEST_TIMEOUT=8
SEARCHLENS_MAX_PAGES=10
SEARCHLENS_MAX_DEPTH=3
SEARCHLENS_MAX_RESPONSE_BYTES=2000000

# Core Web Vitals via PageSpeed Insights. Keyless calls are rate-limited (HTTP 429),
# so a free key is needed: https://developers.google.com/speed/docs/insights/v5/get-started
# Without a key the metric is reported as "unavailable" and left out of the score.
SEARCHLENS_PAGESPEED_API_KEY=
SEARCHLENS_PAGESPEED_STRATEGY=mobile
SEARCHLENS_PAGESPEED_TIMEOUT=60

# LLM that writes the prioritised action list (never the scores).
# Any OpenAI-compatible chat API. Give the API base URL (the part before
# /chat/completions; the full URL also works), the key and the model name.
# If BASE_URL or MODEL is empty, a rule-based fallback list is returned and
# labelled as such in the response.
#
# Examples (base URL -> example model):
#   OpenAI      https://api.openai.com/v1                                -> gpt-4o-mini
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai  -> gemini-3.8-flash
#   Groq        https://api.groq.com/openai/v1                           -> llama-3.3-70b-versatile
#   OpenRouter  https://openrouter.ai/api/v1                             -> any model id on openrouter.ai
#   Ollama      http://localhost:11434/v1  (no key needed)               -> llama3.1
SEARCHLENS_LLM_BASE_URL=
SEARCHLENS_LLM_API_KEY=
SEARCHLENS_LLM_MODEL=
SEARCHLENS_LLM_TIMEOUT=30

# Link checking: unique internal URLs checked per audit (extra ones are reported
# as "not checked"), and how many are checked in parallel.
SEARCHLENS_MAX_LINK_CHECKS=200
SEARCHLENS_LINK_CHECK_WORKERS=4
